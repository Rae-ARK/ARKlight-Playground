{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARKlight Playground",
  "version": "0.1.0",
  "identifier": "dev.arklight.playground",

  "build": {
    "frontendDist": "../app"
  },

  "app": {
    "windows": [
      {
