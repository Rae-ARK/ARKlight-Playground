{
  "name": "arklight-fs",
  "displayName": "ARKlight Workspace Filesystem",
  "description": "Registers a FileSystemProvider for the arklight:// scheme backed by the ARKlight Flask backend.",
  "version": "0.0.1",
  "publisher": "arklight",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./out/extension",
  "browser": "./dist/browser/extension",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onFileSystem:arklight"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "ARKlight",
      "properties": {
        "arklight.backendUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "Base URL of the ARKlight backend (backend/app.py) that this workspace's arklight:/project folder is read from and written to."
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:arklight-fs ./tsconfig.json",
    "vscode:prepublish": "node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.mjs compile-extension:arklight-fs ./tsconfig.json",
    "compile-web": "npm-run-all2 -lp bundle-web typecheck-web",
    "bundle-web": "node ./esbuild.browser.mts",
    "typecheck-web": "node ../../node_modules/@typescript/native/lib/tsc.js --project ./tsconfig.json --noEmit",
    "watch-web": "npm-run-all2 -lp watch-bundle-web watch-typecheck-web",
    "watch-bundle-web": "node ./esbuild.browser.mts --watch",
    "watch-typecheck-web": "node ../../node_modules/@typescript/native/lib/tsc.js --project ./tsconfig.json --noEmit --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rae-ARK/ARKlight-Playground.git"
  },
  "devDependencies": {
    "@types/node": "24.x"
  }
}
